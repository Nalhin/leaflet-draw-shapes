{
  "name": "leaflet-draw-shapes",
  "version": "0.0.0-development",
  "description": "Freehand shape drawing for Leaflet maps — draw, merge, edit and delete polygons with mouse or touch.",
  "keywords": [
    "leaflet",
    "leaflet-plugin",
    "draw",
    "freehand",
    "freedraw",
    "polygon",
    "shapes",
    "map",
    "gis",
    "typescript"
  ],
  "license": "MIT",
  "author": "Krzysztof Olipra",
  "homepage": "https://nalhin.github.io/leaflet-draw-shapes/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nalhin/leaflet-draw-shapes.git"
  },
  "bugs": "https://github.com/Nalhin/leaflet-draw-shapes/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/leaflet-draw-shapes.iife.js",
  "jsdelivr": "./dist/leaflet-draw-shapes.iife.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "tsdown",
    "build:demo": "vite build demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "packageManager": "pnpm@12.6.0",
  "peerDependencies": {
    "@types/leaflet": "^1.9.0",
    "leaflet": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@types/leaflet": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "leaflet": "1.9.4",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7"
  }
}
